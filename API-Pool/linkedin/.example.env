# LinkedIn API — Configuration exemple
# Doc : https://developer.linkedin.com/docs/guide/v2

# OAuth 2.0
LINKEDIN_CLIENT_ID=xxxxxxxxxxxxxxxxxx
LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxxxxxx
LINKEDIN_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Identifiants de ta page / profil
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxxx
LINKEDIN_ORGANIZATION_URN=urn:li:organization:xxxxxxxxx
